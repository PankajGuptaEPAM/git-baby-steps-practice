{
    "servers": {
        "echo": {
            "command": "python",
            "args": [
                "./tools/mcp_echo_server.py"
            ]
        },
        "atlassian": {
            "command": "npx",
            "args": ["-y", "@sooperset/mcp-atlassian"],
            "env": {
                "JIRA_URL": "${env:JIRA_BASE_URL}",
                "JIRA_EMAIL": "${env:JIRA_EMAIL}",
                "JIRA_API_TOKEN": "${env:JIRA_API_TOKEN}",
                "CONFLUENCE_URL": "${env:CONFLUENCE_URL}"
            }
        }
    }
}